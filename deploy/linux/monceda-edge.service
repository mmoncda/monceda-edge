[Unit]
Description=Monceda Edge
Documentation=https://github.com/mmoncda/monceda-edge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monceda-edge
Group=monceda-edge

WorkingDirectory=/var/lib/monceda-edge

ExecStart=/usr/local/bin/monceda-edge serve --config /etc/monceda-edge/monceda-edge.toml

Restart=on-failure
RestartSec=3

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

ReadWritePaths=/var/lib/monceda-edge

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
